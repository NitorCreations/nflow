{
  "name": "explorer",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@azure/msal-browser": "3.13.0",
    "@azure/msal-react": "2.0.15",
    "@fontsource/roboto": "5.2.10",
    "@mui/icons-material": "5.16.6",
    "@mui/material": "5.16.6",
    "d3": "7.9.0",
    "dagre-d3-es": "7.0.14",
    "date-fns": "4.1.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "mui-datatables": "4.3.0",
    "mui-rff": "7.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-final-form": "6.5.9",
    "react-router-dom": "7.15.0"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/http-proxy": "1.17.17",
    "@types/lodash": "4.17.24",
    "@types/mui-datatables": "4.3.13",
    "@types/node": "25.7.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/typescript-estree": "8.59.3",
    "@vitejs/plugin-react": "6.0.1",
    "husky": "9.1.7",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "vite": "8.0.12",
    "vitest": "4.1.6"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy-dev": "npm run build && sed -i 's/http:\\/\\/localhost:3000/https:\\/\\/nflow.io/' build/config.js && aws s3 sync build/ s3://nflow-explorer-dev/dev/"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "preset": "ts-jest/presets/js-with-ts",
    "testEnvironment": "jest-environment-jsdom",
    "moduleNameMapper": {
      "d3": "<rootDir>/node_modules/d3/dist/d3.js",
      "^d3-(.*)$": "<rootDir>/node_modules/d3-$1/dist/d3-$1",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|scss|less)$": "<rootDir>/__mocks__/styleMock.js"
    },
    "modulePaths": [
      "./src"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.2"
}
