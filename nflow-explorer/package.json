{
  "name": "explorer",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@azure/msal-browser": "3.13.0",
    "@azure/msal-react": "2.0.15",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "5.16.6",
    "@mui/material": "5.16.6",
    "d3": "7.9.0",
    "dagre-d3-es": "7.0.14",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "mui-datatables": "4.3.0",
    "mui-rff": "7.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-final-form": "6.5.9",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/http-proxy": "1.17.17",
    "@types/lodash": "4.17.27",
    "@types/mui-datatables": "4.3.13",
    "@types/node": "26.6.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/typescript-estree": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.6"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy-dev": "npm run build && sed -i 's/http:\\/\\/localhost:3000/https:\\/\\/nflow.io/' build/config.js && aws s3 sync build/ s3://nflow-explorer-dev/dev/"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
